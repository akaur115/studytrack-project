generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
model Assignment {
 id        Int      @id @default(autoincrement())
 title     String
 course    String
 priority  String
 dueDate   String
 completed Boolean  @default(false)

model ProgressTask {
  id        Int      @id @default(autoincrement())
  title     String
  owner     String
  status    String
  percent   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}