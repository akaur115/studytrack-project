generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ProgressTask {
  id        Int      @id @default(autoincrement())
  title     String
  owner     String
  status    String
  percent   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}