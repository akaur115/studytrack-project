generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Resource {
  id       Int     @id @default(autoincrement())
  name     String
  category String
  source   String
  saved    Boolean @default(false)
}

model Assignment {
  id        Int     @id @default(autoincrement())
  title     String
  course    String
  priority  String
  dueDate   String
  completed Boolean @default(false)
}

model ProgressTask {
  id      Int    @id @default(autoincrement())
  title   String
  owner   String
  status  String
  percent Int
}